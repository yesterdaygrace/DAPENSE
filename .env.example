APP_NAME=DAPENSE
APP_ENV=production
# Set to true to enable /demo-login outside local (gated, throttled)
DEMO_ENABLED=false
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Host dev uses 127.0.0.1; docker-compose overrides to dapense-mysql (or dapense-postgres) inside container
DB_HOST=127.0.0.1
DB_PORT=3306
# For host `artisan serve` against docker MySQL: DB_PORT=13306 (or $DB_EXTERNAL_PORT)
DB_EXTERNAL_PORT=13306
DB_DATABASE=dapense
DB_USERNAME=root
DB_PASSWORD=

# --- PostgreSQL alternative ---
# To run on PostgreSQL: set DB_CONNECTION=pgsql and point to postgres service
#   DB_CONNECTION=pgsql
#   DB_HOST=dapense-postgres   # inside docker; 127.0.0.1 on host
#   DB_PORT=5432               # host-mapped: 15432 (see docker-compose.pgsql.yml)
#   DB_DATABASE=dapense
#   DB_USERNAME=postgres
#   DB_PASSWORD=               # same as POSTGRES_PASSWORD
# Use: docker compose -f docker-compose.pgsql.yml up --build -d
# See: docs/postgres-migration.md and database/pgsql-export.sh

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your-redis-password-here
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
