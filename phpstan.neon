includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - config
        - routes
    ignoreErrors:
        # Missing type annotations are style strictness (level 6), not bugs.
        # The codebase has never annotated every method/property/iterable;
        # real bug detection (level 6) remains active for everything else.
        - identifier: missingType.return
        - identifier: missingType.parameter
        - identifier: missingType.property
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
